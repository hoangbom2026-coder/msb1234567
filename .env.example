# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ─── Security (REQUIRED — must be at least 32 random characters) ──────────────
JWT_SECRET=change_me_to_at_least_32_random_chars_xxxxxxxxxxxxxxxx

# ─── Database ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password_here
DB_NAME=mbays_game

# ─── CORS / Frontend URLs ─────────────────────────────────────────────────────
# Comma-separated allowed origins for REST + Socket.IO CORS
CLIENT_URL=https://yourdomain.com

# ─── Telegram Bot (configured via Admin UI, not needed here unless seeding) ───
# TG_BOT_TOKEN and TG_ADMIN_CHAT_ID are stored in system_config table (DB),
# NOT in .env — never commit them here.

# ─── Optional ─────────────────────────────────────────────────────────────────
# UPLOAD_MAX_SIZE_MB=10

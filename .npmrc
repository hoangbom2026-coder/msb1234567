# ── npm config for all workspaces ────────────────────────────────────────────
# Use exact versions on install to prevent version drift
save-exact=true

# Prefer local cache before hitting registry (faster CI/CD)
prefer-offline=true

# Use npm ci on install to respect package-lock.json exactly
# (set per-script in deploy.sh instead of globally here)

# Disable fund/audit noise in CI output
fund=false
audit=false

# Engine strict — fail if Node version doesn't match
engine-strict=false
